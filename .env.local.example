NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Data API (local reports only — never commit real keys)
# Property ID: GA4 Admin → Property settings (numeric, not G-…)
# GA4_PROPERTY_ID=123456789
# GA_CLIENT_EMAIL=ga-reader@your-project.iam.gserviceaccount.com
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or one-line JSON: GOOGLE_APPLICATION_CREDENTIALS_JSON={"client_email":"...","private_key":"-----BEGIN..."}

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-url
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# IndexNow (required in production for /api/indexnow)
INDEXNOW_API_SECRET=generate-a-random-secret-here
# INDEXNOW_KEY=893d4c6a-a4f4-4215-829e-df8b4dd1a1f6

# Required in production for distributed rate limits (auth, weather, health, IndexNow).
# Without these, limits are per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for /api/keep-alive (Vercel cron + GitHub Actions — prevents Supabase free-tier pause).
# Use the same value in Vercel Production env and the GitHub Actions CRON_SECRET secret.
# CRON_SECRET=generate-a-random-secret-here
